{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/guard/v1alpha1/contract.schema.json",
  "title": "GuardContract v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "guard.partme.ai/v1alpha1" },
    "kind": { "const": "GuardContract" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": { "id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1} }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "enforcement", "assertion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enforcement": { "enum": ["enforce", "review", "advise"] },
        "assertion": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "subject", "predicate", "object"],
          "properties": {
            "type": { "const": "forbid_relation" },
            "subject": { "type": "string", "minLength": 1 },
            "predicate": { "type": "string", "minLength": 1 },
            "object": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
